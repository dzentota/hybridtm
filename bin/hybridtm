#!/usr/bin/env php
<?php

declare(strict_types=1);

// Composer 2.2+ bin proxies expose the project's autoloader path; otherwise
// fall back to the root-project layout and the vendor/<pkg>/bin layout.
$candidates = [
    $GLOBALS['_composer_autoload_path'] ?? null,
    dirname(__DIR__) . '/vendor/autoload.php',
    dirname(__DIR__, 3) . '/autoload.php',
];
$autoload = null;
foreach ($candidates as $candidate) {
    if (is_string($candidate) && $candidate !== '' && file_exists($candidate)) {
        $autoload = $candidate;
        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, "Run `composer install` first.\n");
    exit(1);
}

require $autoload;

use HybridTM\Console\AnalyzeCommand;
use HybridTM\Console\CompileCommand;
use HybridTM\Console\ExportCommand;
use HybridTM\Console\ImportCommand;
use HybridTM\Console\InitCommand;
use HybridTM\Console\NormalizeCommand;
use Symfony\Component\Console\Application;

$app = new Application('HybridTM Threat Modeler', '0.1.0');
$app->addCommand(new CompileCommand());
$app->addCommand(new InitCommand());
$app->addCommand(new AnalyzeCommand());
$app->addCommand(new ExportCommand());
$app->addCommand(new ImportCommand());
$app->addCommand(new NormalizeCommand());
$app->setDefaultCommand('compile');
$app->run();
