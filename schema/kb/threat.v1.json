{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hybridtm.dev/schema/kb/threat.v1.json",
  "title": "HybridTM KB Threat",
  "description": "A threat entry. Field names mirror Threagile's types.RiskCategory so nothing is lost exchanging content with it. See plan §4.4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "hybridtm.io/kb/v1" },
    "kind": { "const": "Threat" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/threatId" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "stride", "base"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "stride": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["spoofing", "tampering", "repudiation", "information-disclosure", "denial-of-service", "elevation-of-privilege"]
          }
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": ["likelihood", "impact"],
          "properties": {
            "likelihood": {
              "enum": ["unlikely", "possible", "likely", "very-likely", "frequent"]
            },
            "impact": {
              "enum": ["low", "medium", "elevated", "high", "very-high"]
            }
          }
        },
        "standards": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cwe": { "type": "array", "items": { "type": ["integer", "string"] } },
            "capec": { "type": "array", "items": { "type": ["integer", "string"] } },
            "owasp_top10_2021": { "type": "array", "items": { "type": "string" } },
            "owasp_asvs": { "type": "array", "items": { "type": "string" } },
            "mitre_attack": { "type": "array", "items": { "type": "string" } },
            "pci_dss_4": { "type": "array", "items": { "type": "string" } },
            "iso_27001_2022": { "type": "array", "items": { "type": "string" } },
            "nist_800_53": { "type": "array", "items": { "type": "string" } }
          }
        },
        "attacker_goal": { "type": "string" },
        "attack_vectors": { "type": "array", "items": { "type": "string" } },
        "countermeasures": {
          "type": "array",
          "items": { "$ref": "#/$defs/countermeasureId" },
          "minItems": 1
        },
        "false_positives": { "type": "string" },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          },
          "minItems": 1
        }
      }
    }
  },
  "$defs": {
    "threatId": {
      "type": "string",
      "pattern": "^THREAT-[A-Z0-9-]+$"
    },
    "countermeasureId": {
      "type": "string",
      "pattern": "^CM-[A-Z0-9-]+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
