{
    "name": "hybridtm/hybridtm",
    "description": "HybridTM — PHP threat-modeling compiler and analysis engine. Generates Threagile YAML from a PHP DSL and #[DataFlow] code attributes, and evaluates component-aware threat rules against the model.",
    "type": "library",
    "license": "MIT",
    "keywords": ["threat-modeling", "security", "threagile", "stride", "appsec", "devsecops"],
    "require": {
        "php": ">=8.2",
        "nikic/php-parser": "^5.7",
        "symfony/console": "^8.0",
        "symfony/expression-language": "^7.0|^8.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "infection/infection": "^0.29",
        "opis/json-schema": "^2.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "HybridTM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HybridTM\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/hybridtm"
    ],
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "mutation": "infection --min-msi=75 --threads=max",
        "ci": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite",
        "stan": "Run PHPStan at level 8",
        "cs": "Check coding standards without modifying files",
        "cs:fix": "Apply coding-standard fixes",
        "mutation": "Run Infection mutation testing (min MSI 75)",
        "ci": "Run the full local gate: style, static analysis, tests"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "authors": [
        {
            "name": "Alex Tatulchenkov",
            "email": "webtota@gmail.com"
        }
    ],
    "minimum-stability": "stable"
}
